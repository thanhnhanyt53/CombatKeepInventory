<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================================= -->
    <!-- Parent -->
    <!-- ========================================================= -->

    <parent>
        <groupId>com.votri</groupId>
        <artifactId>CombatKeepInventory</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>cki-bukkit</artifactId>

    <name>CombatKeepInventory Bukkit</name>

    <description>
        CombatKeepInventory Bukkit/Paper implementation.
    </description>

    <packaging>jar</packaging>


    <!-- ========================================================= -->
    <!-- Dependencies -->
    <!-- ========================================================= -->

    <dependencies>

        <!-- CKI Core -->
        <dependency>
            <groupId>com.votri</groupId>
            <artifactId>cki-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Paper/Bukkit API -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Optional WorldGuard integration -->
        <dependency>
            <groupId>com.sk89q.worldguard</groupId>
            <artifactId>worldguard-bukkit</artifactId>
            <version>${worldguard.version}</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>


    <!-- ========================================================= -->
    <!-- Build -->
    <!-- ========================================================= -->

    <build>

        <!-- ===================================================== -->
        <!-- Resources -->
        <!-- ===================================================== -->

        <resources>

            <!-- plugin.yml -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>

                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>

            <!-- Runtime configuration -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>

                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>

        </resources>


        <plugins>

            <!-- ================================================= -->
            <!-- Compiler -->
            <!-- ================================================= -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>

                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>


            <!-- ================================================= -->
            <!-- Shade -->
            <!-- ================================================= -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>

                <executions>

                    <execution>
                        <id>shade-core</id>

                        <phase>package</phase>

                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>

                            <!-- Replace original artifact -->
                            <shadedArtifactAttached>false</shadedArtifactAttached>

                            <!-- Keep original Maven POM -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <!-- Let ProGuard perform shrinking -->
                            <minimizeJar>false</minimizeJar>

                        </configuration>

                    </execution>

                </executions>

            </plugin>


            <!-- ================================================= -->
            <!-- ProGuard -->
            <!-- ================================================= -->

            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>

                <dependencies>

                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-base</artifactId>
                        <version>${proguard.version}</version>
                        <scope>runtime</scope>
                    </dependency>

                </dependencies>


                <executions>

                    <execution>

                        <id>obfuscate-production</id>

                        <phase>package</phase>

                        <goals>
                            <goal>proguard</goal>
                        </goals>


                        <configuration>

                            <!-- ================================= -->
                            <!-- General -->
                            <!-- ================================= -->

                            <obfuscate>true</obfuscate>

                            <!-- Replace original artifact -->
                            <attach>false</attach>

                            <mappingFileName>
                                ${project.build.finalName}-mapping.txt
                            </mappingFileName>

                            <seedFileName>
                                ${project.build.finalName}-seeds.txt
                            </seedFileName>

                            <generateTemporaryConfigurationFile>
                                true
                            </generateTemporaryConfigurationFile>


                            <!-- ================================= -->
                            <!-- Java Runtime Libraries -->
                            <!-- ================================= -->

                            <!--
                                Java 21 modular runtime.

                                java.base:
                                Object, String, Class, UUID, Collection, Set, etc.

                                java.logging:
                                java.util.logging.Logger
                            -->

                            <libs>

                                <lib>
                                    ${java.home}/jmods/java.base.jmod
                                </lib>

                                <lib>
                                    ${java.home}/jmods/java.logging.jmod
                                </lib>

                            </libs>


                            <!-- ================================= -->
                            <!-- ProGuard Rules -->
                            <!-- ================================= -->

                            <options>


                                <!-- ================================= -->
                                <!-- Attributes -->
                                <!-- ================================= -->

                                <option>
                                    -keepattributes
                                    RuntimeVisibleAnnotations,
                                    RuntimeInvisibleAnnotations,
                                    RuntimeVisibleParameterAnnotations,
                                    RuntimeInvisibleParameterAnnotations,
                                    AnnotationDefault,
                                    Signature,
                                    InnerClasses,
                                    EnclosingMethod
                                </option>


                                <!-- ================================= -->
                                <!-- Bukkit Entrypoint -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.CombatKeepInventory {
                                        *;
                                    }
                                </option>


                                <!-- ================================= -->
                                <!-- Core Public API -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.core.api.** {
                                        *;
                                    }
                                </option>

                                <option>
                                    -keep public interface
                                    com.votri.combatkeepinv.core.api.** {
                                        *;
                                    }
                                </option>

                                <option>
                                    -keep public enum
                                    com.votri.combatkeepinv.core.api.** {
                                        *;
                                    }
                                </option>


                                <!-- ================================= -->
                                <!-- Core Platform -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.core.platform.** {
                                        *;
                                    }
                                </option>

                                <option>
                                    -keep public interface
                                    com.votri.combatkeepinv.core.platform.** {
                                        *;
                                    }
                                </option>

                                <option>
                                    -keep public enum
                                    com.votri.combatkeepinv.core.platform.** {
                                        *;
                                    }
                                </option>


                                <!-- ================================= -->
                                <!-- Core Events -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.core.event.** {
                                        *;
                                    }
                                </option>


                                <!-- ================================= -->
                                <!-- Bukkit Listeners -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.listener.** {
                                        *;
                                    }
                                </option>


                                <!-- Bukkit EventHandler methods -->

                                <option>
                                    -keepclasseswithmembers,includedescriptorclasses class * {
                                        @org.bukkit.event.EventHandler &lt;methods&gt;;
                                    }
                                </option>


                                <!-- ================================= -->
                                <!-- CombatStateBridge -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.bridge.CombatStateBridge {
                                        *;
                                    }
                                </option>

                                <!-- Nested PayloadWriter contract -->

                                <option>
                                    -keep interface
                                    com.votri.combatkeepinv.bukkit.bridge.CombatStateBridge$PayloadWriter {
                                        *;
                                    }
                                </option>


                                <!-- ================================= -->
                                <!-- Bukkit API -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.api.** {
                                        *;
                                    }
                                </option>


                                <!-- ================================= -->
                                <!-- Commands -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.command.** {
                                        *;
                                    }
                                </option>


                                <!-- ================================= -->
                                <!-- Platform Detector -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.platform.** {
                                        *;
                                    }
                                </option>


                                <!-- ================================= -->
                                <!-- Hooks -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.hook.** {
                                        *;
                                    }
                                </option>


                                <!-- ================================= -->
                                <!-- Detectors -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.detector.** {
                                        *;
                                    }
                                </option>


                                <!-- ================================= -->
                                <!-- Enum Contract -->
                                <!-- ================================= -->

                                <option>
                                    -keepclassmembers enum * {
                                        public static **[] values();
                                        public static ** valueOf(java.lang.String);
                                    }
                                </option>


                                <!-- ================================= -->
                                <!-- External API Warnings -->
                                <!-- ================================= -->

                                <option>
                                    -dontwarn org.bukkit.**
                                </option>

                                <option>
                                    -dontwarn io.papermc.paper.**
                                </option>

                                <option>
                                    -dontwarn net.kyori.adventure.**
                                </option>

                                <option>
                                    -dontwarn com.sk89q.worldguard.**
                                </option>

                                <option>
                                    -dontwarn com.sk89q.worldedit.**
                                </option>

                                <option>
                                    -dontwarn org.jetbrains.annotations.**
                                </option>

                                <option>
                                    -dontwarn javax.annotation.**
                                </option>


                            </options>

                        </configuration>

                    </execution>

                </executions>

            </plugin>

        </plugins>

    </build>

</project>