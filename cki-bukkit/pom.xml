<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ====================================================== -->
    <!-- Parent                                                  -->
    <!-- ====================================================== -->

    <parent>
        <groupId>com.votri</groupId>
        <artifactId>CombatKeepInventory</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>cki-bukkit</artifactId>

    <name>CombatKeepInventory Bukkit</name>
    <description>
        CombatKeepInventory Bukkit/Paper implementation.
    </description>

    <packaging>jar</packaging>

    <!-- ====================================================== -->
    <!-- Dependencies                                           -->
    <!-- ====================================================== -->

    <dependencies>

        <!-- CKI Core is bundled into the final plugin JAR. -->
        <dependency>
            <groupId>com.votri</groupId>
            <artifactId>cki-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Provided by Paper/Bukkit at runtime. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Optional dependency provided by the server. -->
        <dependency>
            <groupId>com.sk89q.worldguard</groupId>
            <artifactId>worldguard-bukkit</artifactId>
            <version>${worldguard.version}</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <!-- ====================================================== -->
    <!-- Build                                                  -->
    <!-- ====================================================== -->

    <build>

        <resources>

            <!-- plugin.yml contains ${project.version}. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>

            <!-- Do not modify config/message resources. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>

        </resources>

        <plugins>

            <!-- ================================================== -->
            <!-- Compiler                                            -->
            <!-- ================================================== -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>

                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <!-- ================================================== -->
            <!-- Shade                                               -->
            <!-- ================================================== -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>

                <executions>

                    <execution>
                        <id>shade-core</id>
                        <phase>package</phase>

                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>

                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>

                            <!-- Keep all CKI classes before ProGuard. -->
                            <minimizeJar>false</minimizeJar>

                            <!-- Never relocate CKI packages. -->
                            <relocations>
                                <!-- Intentionally empty -->
                            </relocations>

                        </configuration>

                    </execution>

                </executions>
            </plugin>

            <!-- ================================================== -->
            <!-- ProGuard                                            -->
            <!-- ================================================== -->

            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>

                <dependencies>

                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-base</artifactId>
                        <version>${proguard.version}</version>
                        <scope>runtime</scope>
                    </dependency>

                </dependencies>

                <executions>

                    <execution>
                        <id>obfuscate-production</id>
                        <phase>package</phase>

                        <goals>
                            <goal>proguard</goal>
                        </goals>

                        <configuration>

                            <!-- Replace the project artifact with the
                                 obfuscated artifact. -->
                            <obfuscate>true</obfuscate>

                            <attach>false</attach>

                            <mappingFileName>
                                ${project.build.finalName}-mapping.txt
                            </mappingFileName>

                            <seedFileName>
                                ${project.build.finalName}-seeds.txt
                            </seedFileName>

                            <generateTemporaryConfigurationFile>
                                true
                            </generateTemporaryConfigurationFile>

                            <options>

                                <!-- ============================== -->
                                <!-- Java metadata                   -->
                                <!-- ============================== -->

                                <option>
                                    -keepattributes
                                    RuntimeVisibleAnnotations,
                                    RuntimeInvisibleAnnotations,
                                    RuntimeVisibleParameterAnnotations,
                                    RuntimeInvisibleParameterAnnotations,
                                    AnnotationDefault,
                                    Signature,
                                    InnerClasses,
                                    EnclosingMethod
                                </option>

                                <!-- ============================== -->
                                <!-- Bukkit plugin entrypoint       -->
                                <!-- ============================== -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.CombatKeepInventory {
                                    *;
                                    }
                                </option>

                                <!-- ============================== -->
                                <!-- Public CKI API                  -->
                                <!-- ============================== -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.core.api.** {
                                    *;
                                    }
                                </option>

                                <option>
                                    -keep public interface
                                    com.votri.combatkeepinv.core.api.** {
                                    *;
                                    }
                                </option>

                                <option>
                                    -keep public enum
                                    com.votri.combatkeepinv.core.api.** {
                                    *;
                                    }
                                </option>

                                <!-- Platform API contract -->
                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.core.platform.** {
                                    *;
                                    }
                                </option>

                                <option>
                                    -keep public enum
                                    com.votri.combatkeepinv.core.platform.** {
                                    *;
                                    }
                                </option>

                                <!-- Core event contract -->
                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.core.event.** {
                                    *;
                                    }
                                </option>

                                <!-- ============================== -->
                                <!-- Bukkit resource files          -->
                                <!-- ============================== -->

                                <option>
                                    -keepresourcefiles
                                    plugin.yml,config.yml,message.yml
                                </option>

                                <option>
                                    -keepdirectories
                                </option>

                                <!-- ============================== -->
                                <!-- Annotations/framework metadata  -->
                                <!-- ============================== -->

                                <option>
                                    -dontnote
                                </option>

                                <option>
                                    -dontwarn org.jetbrains.annotations.**
                                </option>

                                <option>
                                    -dontwarn javax.annotation.**
                                </option>

                            </options>

                        </configuration>

                    </execution>

                </executions>

            </plugin>

        </plugins>

    </build>

</project>