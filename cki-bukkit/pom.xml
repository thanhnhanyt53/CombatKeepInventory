<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ====================================================== -->
    <!-- Parent -->
    <!-- ====================================================== -->

    <parent>
        <groupId>com.votri</groupId>
        <artifactId>CombatKeepInventory</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>cki-bukkit</artifactId>

    <name>CombatKeepInventory Bukkit</name>

    <description>
        CombatKeepInventory Bukkit/Paper implementation.
    </description>

    <packaging>jar</packaging>

    <!-- ====================================================== -->
    <!-- Dependencies -->
    <!-- ====================================================== -->

    <dependencies>

        <!--
             CKI Core is bundled into the final Bukkit JAR.
        -->
        <dependency>
            <groupId>com.votri</groupId>
            <artifactId>cki-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
             Paper API is provided by the server.
        -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
             WorldGuard is optional at runtime.
             CKI detects its presence and does not require it.
        -->
        <dependency>
            <groupId>com.sk89q.worldguard</groupId>
            <artifactId>worldguard-bukkit</artifactId>
            <version>${worldguard.version}</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <!-- ====================================================== -->
    <!-- Build -->
    <!-- ====================================================== -->

    <build>

        <!-- ================================================== -->
        <!-- Resources -->
        <!-- ================================================== -->

        <resources>

            <!--
                 Only plugin.yml is filtered because it contains
                 Maven project properties such as ${project.version}.
            -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>

                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>

            <!--
                 Runtime configuration must NEVER be Maven-filtered.
                 This preserves the user's placeholders and YAML values.
            -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>

                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>

        </resources>

        <plugins>

            <!-- ================================================== -->
            <!-- Compiler -->
            <!-- ================================================== -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>

                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <!-- ================================================== -->
            <!-- Shade CKI Core -->
            <!-- ================================================== -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>

                <executions>

                    <execution>
                        <id>shade-core</id>

                        <phase>package</phase>

                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>

                            <!--
                                 Keep the original project artifact name.
                            -->
                            <shadedArtifactAttached>false</shadedArtifactAttached>

                            <!--
                                 Do not generate dependency-reduced-pom.xml.
                            -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <!--
                                 Do not let Shade remove classes.
                                 ProGuard performs the optimization/obfuscation
                                 afterwards.
                            -->
                            <minimizeJar>false</minimizeJar>

                            <!--
                                 Do NOT relocate CKI packages.

                                 The public API is intentionally stable because
                                 external plugins will hook CombatKeepInventory.
                            -->
                            <relocations>
                            </relocations>

                        </configuration>
                    </execution>

                </executions>
            </plugin>

            <!-- ================================================== -->
            <!-- ProGuard -->
            <!-- ================================================== -->

            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>

                <dependencies>

                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-base</artifactId>
                        <version>${proguard.version}</version>
                        <scope>runtime</scope>
                    </dependency>

                </dependencies>

                <executions>

                    <execution>

                        <id>obfuscate-production</id>

                        <phase>package</phase>

                        <goals>
                            <goal>proguard</goal>
                        </goals>

                        <configuration>

                            <!--
                                 Replace the normal JAR with the
                                 obfuscated production JAR.
                            -->
                            <obfuscate>true</obfuscate>

                            <attach>false</attach>

                            <mappingFileName>
                                ${project.build.finalName}-mapping.txt
                            </mappingFileName>

                            <seedFileName>
                                ${project.build.finalName}-seeds.txt
                            </seedFileName>

                            <generateTemporaryConfigurationFile>
                                true
                            </generateTemporaryConfigurationFile>

                            <options>

                                <!-- ================================= -->
                                <!-- Java metadata -->
                                <!-- ================================= -->

                                <option>
                                    -keepattributes
                                    RuntimeVisibleAnnotations,
                                    RuntimeInvisibleAnnotations,
                                    RuntimeVisibleParameterAnnotations,
                                    RuntimeInvisibleParameterAnnotations,
                                    AnnotationDefault,
                                    Signature,
                                    InnerClasses,
                                    EnclosingMethod,
                                    SourceFile,
                                    LineNumberTable
                                </option>

                                <!-- ================================= -->
                                <!-- Bukkit entry point -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.CombatKeepInventory {
                                    *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Bukkit commands -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.command.** {
                                    *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Bukkit listeners -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.listener.** {
                                    *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Bukkit API -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.api.** {
                                    *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Bukkit hooks -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.hook.** {
                                    *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Bukkit platform -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.platform.** {
                                    *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Bukkit combat implementation -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.combat.** {
                                    *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Bukkit detectors -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.bukkit.detector.** {
                                    *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Core public API -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.core.api.** {
                                    *;
                                    }
                                </option>

                                <option>
                                    -keep public interface
                                    com.votri.combatkeepinv.core.api.** {
                                    *;
                                    }
                                </option>

                                <option>
                                    -keep public enum
                                    com.votri.combatkeepinv.core.api.** {
                                    *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Core platform contract -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.core.platform.** {
                                    *;
                                    }
                                </option>

                                <option>
                                    -keep public interface
                                    com.votri.combatkeepinv.core.platform.** {
                                    *;
                                    }
                                </option>

                                <option>
                                    -keep public enum
                                    com.votri.combatkeepinv.core.platform.** {
                                    *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Core events -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.core.event.** {
                                    *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- API implementation used by hooks -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.core.** {
                                    public *;
                                }
                                </option>

                                <!-- ================================= -->
                                <!-- Enum support -->
                                <!-- ================================= -->

                                <option>
                                    -keepclassmembers enum * {
                                    public static **[] values();
                                    public static ** valueOf(java.lang.String);
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Reflection -->
                                <!-- ================================= -->

                                <option>
                                    -keepclassmembers class * {
                                    @org.bukkit.event.EventHandler &lt;methods&gt;;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Native methods -->
                                <!-- ================================= -->

                                <option>
                                    -keepclasseswithmembernames,includedescriptorclasses class * {
                                    native &lt;methods&gt;;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Optional dependencies -->
                                <!-- ================================= -->

                                <option>
                                    -dontwarn org.jetbrains.annotations.**
                                </option>

                                <option>
                                    -dontwarn javax.annotation.**
                                </option>

                                <option>
                                    -dontnote
                                </option>

                            </options>

                        </configuration>

                    </execution>

                </executions>

            </plugin>

        </plugins>

    </build>

</project>