<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================================= -->
    <!-- Parent -->
    <!-- ========================================================= -->

    <parent>
        <groupId>com.votri</groupId>
        <artifactId>CombatKeepInventory</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>cki-velocity</artifactId>

    <name>CombatKeepInventory Velocity</name>

    <description>
        CombatKeepInventory Velocity proxy implementation.
    </description>

    <packaging>jar</packaging>

    <!-- ========================================================= -->
    <!-- Dependencies -->
    <!-- ========================================================= -->

    <dependencies>

        <!-- ===================================================== -->
        <!-- CKI Core -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>com.votri</groupId>
            <artifactId>cki-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ===================================================== -->
        <!-- Velocity API -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
            <version>${velocity.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ===================================================== -->
        <!-- SnakeYAML -->
        <!-- Used directly by VelocityConfig -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>${snakeyaml.version}</version>
        </dependency>

    </dependencies>

    <!-- ========================================================= -->
    <!-- Build -->
    <!-- ========================================================= -->

    <build>

        <!-- ===================================================== -->
        <!-- Resources -->
        <!-- ===================================================== -->

        <resources>

            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>

        </resources>

        <plugins>

            <!-- ================================================= -->
            <!-- Compiler -->
            <!-- ================================================= -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>

                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>

            </plugin>

            <!-- ================================================= -->
            <!-- Shade -->
            <!-- ================================================= -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>

                <executions>

                    <execution>
                        <id>shade-runtime-dependencies</id>

                        <phase>package</phase>

                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>

                            <!-- Replace original artifact -->
                            <shadedArtifactAttached>false</shadedArtifactAttached>

                            <!-- Do not create dependency-reduced-pom -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <!-- Let ProGuard process the complete jar -->
                            <minimizeJar>false</minimizeJar>

                            <!-- No package relocation -->
                            <relocations>
                            </relocations>

                        </configuration>

                    </execution>

                </executions>

            </plugin>

            <!-- ================================================= -->
            <!-- ProGuard -->
            <!-- ================================================= -->

            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>

                <dependencies>

                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-base</artifactId>
                        <version>${proguard.version}</version>
                        <scope>runtime</scope>
                    </dependency>

                </dependencies>

                <executions>

                    <execution>

                        <id>obfuscate-production</id>

                        <phase>package</phase>

                        <goals>
                            <goal>proguard</goal>
                        </goals>

                        <configuration>

                            <obfuscate>true</obfuscate>

                            <!-- Replace final artifact -->
                            <attach>false</attach>

                            <mappingFileName>
                                ${project.build.finalName}-mapping.txt
                            </mappingFileName>

                            <seedFileName>
                                ${project.build.finalName}-seeds.txt
                            </seedFileName>

                            <generateTemporaryConfigurationFile>
                                true
                            </generateTemporaryConfigurationFile>

                            <options>

                                <!-- ================================= -->
                                <!-- JDK -->
                                <!-- ================================= -->

                                <option>
                                    -libraryjars ${java.home}/jmods/java.base.jmod
                                </option>

                                <!-- ================================= -->
                                <!-- Metadata -->
                                <!-- ================================= -->

                                <option>
                                    -keepattributes
                                    RuntimeVisibleAnnotations,
                                    RuntimeInvisibleAnnotations,
                                    RuntimeVisibleParameterAnnotations,
                                    RuntimeInvisibleParameterAnnotations,
                                    AnnotationDefault,
                                    Signature,
                                    InnerClasses,
                                    EnclosingMethod
                                </option>

                                <!-- ================================= -->
                                <!-- Velocity plugin entrypoint -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.velocity.CombatKeepInventoryVelocity {
                                        *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Velocity plugin annotation -->
                                <!-- ================================= -->

                                <option>
                                    -keep @com.velocitypowered.api.plugin.Plugin
                                    public class * {
                                        *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Velocity event listeners -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.velocity.listener.** {
                                        *;
                                    }
                                </option>

                                <option>
                                    -keepclassmembers class * {
                                        @com.velocitypowered.api.event.Subscribe
                                        &lt;methods&gt;;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- CKI Core API -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.core.api.** {
                                        *;
                                    }
                                </option>

                                <option>
                                    -keep public interface
                                    com.votri.combatkeepinv.core.api.** {
                                        *;
                                    }
                                </option>

                                <option>
                                    -keep public enum
                                    com.votri.combatkeepinv.core.api.** {
                                        *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Core platform contract -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.core.platform.** {
                                        *;
                                    }
                                </option>

                                <option>
                                    -keep public interface
                                    com.votri.combatkeepinv.core.platform.** {
                                        *;
                                    }
                                </option>

                                <option>
                                    -keep public enum
                                    com.votri.combatkeepinv.core.platform.** {
                                        *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Core events -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.core.event.** {
                                        *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Velocity API -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.velocity.api.** {
                                        *;
                                    }
                                </option>

                                <option>
                                    -keep public interface
                                    com.votri.combatkeepinv.velocity.api.** {
                                        *;
                                    }
                                </option>

                                <option>
                                    -keep public enum
                                    com.votri.combatkeepinv.velocity.api.** {
                                        *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Session -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.velocity.session.** {
                                        *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Config -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.velocity.config.** {
                                        *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Platform -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.velocity.platform.** {
                                        *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Commands -->
                                <!-- ================================= -->

                                <option>
                                    -keep public class
                                    com.votri.combatkeepinv.velocity.command.** {
                                        *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- SnakeYAML -->
                                <!-- ================================= -->

                                <option>
                                    -keep class org.yaml.snakeyaml.** {
                                        *;
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Enum support -->
                                <!-- ================================= -->

                                <option>
                                    -keepclassmembers enum * {
                                        public static **[] values();
                                        public static ** valueOf(java.lang.String);
                                    }
                                </option>

                                <!-- ================================= -->
                                <!-- Velocity external API -->
                                <!-- ================================= -->

                                <option>
                                    -dontwarn com.velocitypowered.**
                                </option>

                                <option>
                                    -dontwarn net.kyori.**
                                </option>

                                <option>
                                    -dontwarn org.slf4j.**
                                </option>

                                <option>
                                    -dontwarn com.google.inject.**
                                </option>

                                <!-- ================================= -->
                                <!-- SnakeYAML optional references -->
                                <!-- ================================= -->

                                <option>
                                    -dontwarn org.yaml.snakeyaml.**
                                </option>

                                <option>
                                    -dontwarn org.jetbrains.annotations.**
                                </option>

                                <option>
                                    -dontwarn javax.annotation.**
                                </option>

                                <!-- ================================= -->
                                <!-- ProGuard stability -->
                                <!-- ================================= -->

                                <option>
                                    -dontpreverify
                                </option>

                                <option>
                                    -dontusemixedcaseclassnames
                                </option>

                            </options>

                        </configuration>

                    </execution>

                </executions>

            </plugin>

        </plugins>

    </build>

</project>