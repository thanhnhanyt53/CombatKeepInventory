<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.votri</groupId>
    <artifactId>CombatKeepInventory</artifactId>
    <version>1.2.5</version>
    <packaging>pom</packaging>

    <name>CombatKeepInventory</name>

    <modules>
        <module>cki-core</module>
        <module>cki-bukkit</module>
        <module>cki-velocity</module>
    </modules>

    <properties>
        <!--
          16 is the lowest Java release that still accepts every
          language feature already used across the modules
          (records, pattern-matching instanceof, switch
          expressions: all stable since 16). It is also exactly
          the minimum JRE Minecraft 1.17 itself requires, so the
          compiled bytecode loads on 1.17 through 1.21.x/26.x JVMs
          alike (newer JVMs always run older bytecode fine; the
          reverse is what breaks). Do not raise this without
          checking whether newer-only syntax or java.* API has
          been introduced since.
        -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <paper.api.version>1.20.1-R0.1-SNAPSHOT</paper.api.version>
        <velocity.api.version>3.4.0-SNAPSHOT</velocity.api.version>
        <worldguard.version>7.0.16</worldguard.version>
        <snakeyaml.version>2.4</snakeyaml.version>

        <maven.compiler.version>3.14.1</maven.compiler.version>
        <maven.jar.version>3.4.2</maven.jar.version>
        <maven.shade.version>3.6.0</maven.shade.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>enginehub</id>
            <url>https://maven.enginehub.org/repo/</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven.shade.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
